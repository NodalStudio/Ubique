{
  "name": "@nodalstudio/ubique",
  "version": "1.0.4",
  "description": "A high-performance mathematical and quantitative library, leveraging WebAssembly for efficient linear algebra and numerical computations",
  "license": "MIT",
  "compilerOptions": {
    "strict": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/NodalStudio/Ubique.git"
  },
  "keywords": [
    "mathematics",
    "matrix",
    "arithmetic",
    "statistics",
    "linear algebra",
    "matlab",
    "regression",
    "finance",
    "quantitative analysis"
  ],
  "contributors": [
    {
      "name": "Benoît Mayer",
      "email": "mayer.benoit@gmail.com",
      "url": "https://github.com/bemayer"
    },
    {
      "name": "Max Todaro",
      "email": "m.todaro.ge@gmail.com",
      "url": "https://github.com/maxto"
    }
  ],
  "tasks": {
    "test": "deno fmt --check lib && deno test --doc lib test/deno.test.ts test/numerics_test.ts test/correctness_test.ts test/article_test.ts test/benchmark_timing_test.ts test/reference_regressions_test.ts",
    "test:npm": "node scripts/test_npm.js && node scripts/test_npm_esm.mjs",
    "test:browser": "deno run -A scripts/test_browser.mjs",
    "test:benchmark:browser": "deno run -A scripts/test_benchmark_browser.mjs",
    "lint": "deno lint lib",
    "lint:fix": "deno fmt lib && deno lint --fix lib",
    "build": "deno run -A jsr:@deno/wasmbuild@0.23.0 --out ./rs_lib/pkg --inline --skip-opt",
    "build:npm": "deno run -A ./scripts/build_npm.ts",
    "docs": "deno run -A ./scripts/build_docs.ts",
    "benchmark": "deno run --allow-write --allow-sys=cpus ./scripts/benchmark.ts",
    "deploy": "deno task build && deno task test && deno task lint:fix && deno publish --allow-dirty",
    "build:simd": "RUSTFLAGS=\"-C target-feature=+simd128\" deno run -A jsr:@deno/wasmbuild@0.23.0 --out ./rs_lib/pkg_simd --inline --skip-opt"
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ]
    },
    "include": [
      "scripts/",
      "lib/",
      "test/"
    ],
    "exclude": [
      "dist/"
    ]
  },
  "imports": {
    "dayjs": "npm:dayjs@1.11.13"
  },
  "exports": {
    ".": "./index.ts"
  },
  "publish": {
    "include": [
      "index.ts",
      "lib/**/*.ts",
      "rs_lib/pkg/*.js",
      "rs_lib/pkg/*.ts",
      "README.md",
      "LICENSE"
    ],
    "exclude": [
      "scripts/",
      "docs/",
      "target/",
      "test/",
      "rs_lib/src/",
      "rs_lib/Cargo.toml",
      "*.md",
      "!README.md",
      "!LICENSE",
      "package.json",
      "package-lock.json",
      "node_modules/",
      "vitest.config.ts"
    ]
  },
  "fmt": {
    "include": [
      "lib/",
      "index.ts",
      "scripts/",
      "test/",
      "deno.json"
    ],
    "exclude": [
      "rs_lib/pkg/",
      "target/",
      "node_modules/",
      "docs/",
      "dist/",
      "scripts/assets/"
    ]
  }
}
